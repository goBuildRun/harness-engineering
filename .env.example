# Harness 本地环境变量（复制为 .env 并填写，勿提交 Git）
# cp .env.example .env

# 可选：临时覆盖产品侧 harness-workspace/project.yaml 的 work_item.provider。
# 推荐把长期选择写在产品侧 project.yaml，例如 A=teambition、B=feishu、C=jira。
# WORK_ITEM_PROVIDER=teambition
# WORK_ITEM_PROVIDER=feishu
# WORK_ITEM_PROVIDER=jira

# 钉钉企业内部应用（开放平台 → 应用开发 → 企业内部应用）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# Teambition / 钉钉项目管理
# 须为钉钉通讯录 userId（纯数字），非 Teambition 24 位十六进制 _id
DINGTALK_OPERATOR_USER_ID=
# 可选覆盖：长期建议写在产品侧 harness-workspace/project.yaml 的 providers.teambition.project_id
TEAMBITION_PROJECT_ID=

# 飞书开放平台应用（飞书开放平台 → 企业自建应用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 兼容默认：仅在产品侧未配置 providers.feishu.tasklist_guid 时使用
FEISHU_TASKLIST_GUID=
# 显式临时覆盖产品 tasklist_guid；不要把通用 Harness 清单写在这里长期复用
FEISHU_TASKLIST_GUID_OVERRIDE=
# 可选：默认负责人 ID（open_id / union_id 取决于租户 API 配置）
FEISHU_ASSIGNEE_ID=

# Jira / Atlassian Cloud
# 可选覆盖：长期建议写在产品侧 providers.jira.base_url
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# 可选覆盖：长期建议写在产品侧 providers.jira.project_key；sync-spec 创建 issue 时需要
JIRA_PROJECT_KEY=
# 可选：默认 Task
JIRA_ISSUE_TYPE=
# 可选：只有启用状态流转时填写；默认不会移动 Jira 状态
JIRA_DONE_TRANSITION_ID=
